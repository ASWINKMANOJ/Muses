# Muses RAG — Environment Configuration
# Copy this file to .env and edit as needed.

# ── LLM (Ollama) ──────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
LLM_MODEL=gemma3:4b
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=512
LLM_NUM_GPU=99                  # Offload all model layers to GPU (99 = max)

# ── Embedding Model ────────────────────────────────────────────────────────────
# nlpaueb/legal-bert-base-uncased  → best for legal (recommended)
# sentence-transformers/all-mpnet-base-v2 → strong general purpose
# all-MiniLM-L6-v2                → lightweight but weaker on legal text
EMBEDDING_MODEL=nlpaueb/legal-bert-base-uncased
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ── Retrieval ──────────────────────────────────────────────────────────────────
RETRIEVAL_N_CANDIDATES=20
RETRIEVAL_TOP_K=5
BM25_WEIGHT=0.5
HYDE_ENABLED=true
CROSS_ENCODER_ENABLED=false

# ── Paths ──────────────────────────────────────────────────────────────────────
CHROMA_DB_PATH=db
UPLOADS_DIR=uploads
