# Muses RAG — Environment Configuration
# Copy this file to .env and edit as needed.

# ── LLM (Ollama) ──────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
LLM_MODEL=gemma3:4b
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=512
LLM_NUM_GPU=99                  # Offload all model layers to GPU (99 = max)

# ── Embedding Model ────────────────────────────────────────────────────────────
# BAAI/bge-base-en-v1.5          → strong retrieval bi-encoder (recommended)
# BAAI/bge-small-en-v1.5         → faster/lighter on CPU
# sentence-transformers/all-mpnet-base-v2 → strong general purpose
# Changing EMBEDDING_MODEL requires re-ingest into a new CHROMA_COLLECTION.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ── Retrieval ──────────────────────────────────────────────────────────────────
RETRIEVAL_N_CANDIDATES=20
RETRIEVAL_TOP_K=5
BM25_WEIGHT=0.5
HYDE_ENABLED=true
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CRAG_MIN_CONFIDENCE=-5.0

# ── Semantic Cache ─────────────────────────────────────────────────────────────
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_SIZE=200

# ── Paths ──────────────────────────────────────────────────────────────────────
CHROMA_DB_PATH=db
CHROMA_COLLECTION=documents_bge_base
UPLOADS_DIR=uploads
